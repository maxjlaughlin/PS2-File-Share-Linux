[Unit]
Description=PS2 File Share — SMB share manager for Open PS2 Loader
Documentation=https://github.com/maxjlaughlin/PS2-File-Share-Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@APP_DIR@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/env python3 -m ps2share serve
Restart=on-failure
RestartSec=5

# The app edits /etc/samba, controls smbd and chowns files in the share, so it
# runs as root. These keep that as narrow as it can usefully be — note that
# ProtectSystem is deliberately absent, because writing /etc/samba is the job.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
